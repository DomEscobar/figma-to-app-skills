{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decisionAuthority", "runs"],
  "properties": {
    "version": { "const": 1 },
    "decisionAuthority": { "const": "diagnostic-only" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "modelVersion", "referenceSha256", "actualSha256", "regions"],
        "properties": {
          "provider": { "enum": ["omniparser", "grounding-dino-sam", "sam3", "dinov2", "lpips", "dists"] },
          "modelVersion": { "type": "string", "minLength": 1 },
          "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "actualSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "confidence", "box"],
              "properties": {
                "label": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "box": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number", "minimum": 0 },
                    "height": { "type": "number", "minimum": 0 }
                  }
                },
                "mask": { "type": ["string", "null"] },
                "score": { "type": ["number", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
