{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/design-memory-config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceRoots", "componentRoots", "extensions", "ignoreDirs", "allowRawValues", "properties"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "sourceRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "componentRoots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
    "ignoreDirs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowRawValues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "properties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z-]+$"}}
  }
}
